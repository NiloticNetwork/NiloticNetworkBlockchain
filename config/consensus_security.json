{
    "security_config": {
        "version": "1.0",
        "last_updated": "2024-01-01T00:00:00Z",
        "description": "Consensus Harmony Security Configuration"
    },
    "cryptographic_validation": {
        "enabled": true,
        "require_strong_crypto": true,
        "supported_algorithms": [
            "RSA-2048",
            "RSA-4096",
            "ECDSA-P256",
            "ECDSA-P384",
            "ECDSA-P521",
            "Ed25519"
        ],
        "hash_algorithms": [
            "SHA-256",
            "SHA-384",
            "SHA-512"
        ],
        "minimum_signature_length": 64,
        "signature_validation_timeout": 5000
    },
    "attack_detection": {
        "enabled": true,
        "detection_window_seconds": 3600,
        "max_suspicious_activity_threshold": 10,
        "rate_limiting": {
            "enabled": true,
            "max_requests_per_minute": 100,
            "max_requests_per_hour": 1000,
            "burst_threshold": 50
        },
        "timestamp_validation": {
            "max_future_drift_seconds": 600,
            "max_past_drift_seconds": 86400
        },
        "sybil_detection": {
            "max_identities_per_source": 10,
            "similarity_threshold": 0.8
        },
        "consensus_dominance": {
            "max_mechanism_dominance_ratio": 0.51,
            "monitoring_window_blocks": 100
        }
    },
    "audit_logging": {
        "enabled": true,
        "log_level": "INFO",
        "file_logging": {
            "enabled": true,
            "log_file_path": "logs/consensus_security_audit.log",
            "max_file_size_mb": 100,
            "max_files": 10,
            "rotation_enabled": true
        },
        "database_logging": {
            "enabled": false,
            "database_path": "logs/security_audit.db"
        },
        "remote_logging": {
            "enabled": false,
            "endpoint": "",
            "api_key": ""
        },
        "encryption": {
            "enabled": false,
            "encryption_key": ""
        },
        "events_to_log": [
            "CONSENSUS_VALIDATION",
            "SECURITY_VIOLATION",
            "ATTACK_DETECTED",
            "CRYPTO_VALIDATION_FAILED",
            "PARAMETER_CHANGED",
            "EMERGENCY_MODE_ACTIVATED",
            "SYSTEM_STARTUP",
            "SYSTEM_SHUTDOWN"
        ]
    },
    "emergency_mode": {
        "enabled": true,
        "auto_activation_triggers": [
            "CRITICAL_SECURITY_VIOLATION",
            "CONSENSUS_ATTACK_DETECTED",
            "SYSTEM_COMPROMISE_SUSPECTED"
        ],
        "activation_thresholds": {
            "security_violations_per_hour": 50,
            "failed_validations_ratio": 0.5,
            "attack_detection_count": 10
        },
        "recovery_conditions": {
            "manual_override_required": true,
            "cooling_period_minutes": 30,
            "validation_success_ratio": 0.95
        }
    },
    "monitoring": {
        "enabled": true,
        "health_check_interval_seconds": 60,
        "metrics_collection_interval_seconds": 30,
        "alert_thresholds": {
            "security_violation_rate": 0.1,
            "attack_detection_rate": 0.05,
            "crypto_failure_rate": 0.01,
            "consensus_conflict_rate": 0.02
        },
        "notifications": {
            "email_alerts": {
                "enabled": false,
                "recipients": [],
                "smtp_server": "",
                "smtp_port": 587
            },
            "webhook_alerts": {
                "enabled": false,
                "webhook_url": "",
                "secret_key": ""
            }
        }
    },
    "performance": {
        "validation_timeout_ms": 10000,
        "max_concurrent_validations": 100,
        "cache_enabled": true,
        "cache_size_mb": 50,
        "cache_ttl_seconds": 300,
        "batch_processing": {
            "enabled": true,
            "batch_size": 100,
            "batch_timeout_ms": 1000
        }
    },
    "testing": {
        "penetration_testing": {
            "enabled": true,
            "test_intervals_hours": 24,
            "attack_scenarios": [
                "ddos_simulation",
                "timestamp_manipulation",
                "sybil_attack",
                "51_percent_attack",
                "double_spending",
                "cryptographic_attacks",
                "consensus_flooding",
                "malformed_data",
                "replay_attacks",
                "eclipse_attack",
                "long_range_attack",
                "nothing_at_stake",
                "selfish_mining",
                "consensus_disruption"
            ]
        },
        "security_regression_testing": {
            "enabled": true,
            "test_on_code_changes": true,
            "automated_testing": true
        }
    },
    "compliance": {
        "security_standards": [
            "ISO_27001",
            "NIST_Cybersecurity_Framework"
        ],
        "audit_requirements": {
            "regular_audits": true,
            "audit_frequency_months": 6,
            "external_audits": true,
            "penetration_testing": true
        },
        "data_protection": {
            "encryption_at_rest": true,
            "encryption_in_transit": true,
            "key_management": "secure",
            "data_retention_days": 365
        }
    }
}