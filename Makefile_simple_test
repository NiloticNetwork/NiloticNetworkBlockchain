CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -O2

# Simple test without external dependencies
test_simple: tests/test_oderoslw_simple.cpp
	$(CXX) $(CXXFLAGS) -o test_oderoslw_simple tests/test_oderoslw_simple.cpp

# Run simple test
test: test_simple
	@echo "Running simplified OderoSLW tests..."
	./test_oderoslw_simple

# Clean
clean:
	rm -f test_oderoslw_simple

.PHONY: test clean