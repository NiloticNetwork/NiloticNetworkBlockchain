CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -I../include -I../include/core -I/opt/homebrew/include
LDFLAGS = -L/opt/homebrew/lib -lssl -lcrypto -lpthread -lsqlite3

SRCDIR = ../src/core
SOURCES = $(SRCDIR)/consensus_harmony.cpp $(SRCDIR)/consensus_router.cpp $(SRCDIR)/block.cpp $(SRCDIR)/transaction.cpp $(SRCDIR)/utils.cpp $(SRCDIR)/logger.cpp

test_consensus_router_simple: test_consensus_router_simple.cpp $(SOURCES)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

clean:
	rm -f test_consensus_router_simple

run: test_consensus_router_simple
	./test_consensus_router_simple

.PHONY: clean run