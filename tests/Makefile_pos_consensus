# Makefile for PoS Consensus Engine Tests
CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -Iinclude -Ilib/nlohmann_json/single_include
LDFLAGS = -lgtest -lgtest_main -pthread

# Source files
SOURCES = tests/pos_consensus_engine_test.cpp \
          src/core/pos_consensus_engine.cpp \
          src/core/consensus_harmony.cpp \
          src/core/block.cpp \
          src/core/transaction.cpp \
          src/core/logger.cpp \
          src/core/utils.cpp

# Object files
OBJECTS = $(SOURCES:.cpp=.o)

# Target executable
TARGET = test_pos_consensus_engine

# Default target
all: $(TARGET)

# Build the test executable
$(TARGET): $(OBJECTS)
	$(CXX) $(OBJECTS) -o $(TARGET) $(LDFLAGS)

# Compile source files
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Run tests
test: $(TARGET)
	./$(TARGET)

# Clean build files
clean:
	rm -f $(OBJECTS) $(TARGET)

# Install dependencies (Ubuntu/Debian)
install-deps:
	sudo apt-get update
	sudo apt-get install -y libgtest-dev cmake
	cd /usr/src/gtest && sudo cmake . && sudo make && sudo cp lib/*.a /usr/lib/

.PHONY: all test clean install-deps