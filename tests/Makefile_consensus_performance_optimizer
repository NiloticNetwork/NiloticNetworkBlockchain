# Makefile for Consensus Performance Optimizer Tests

CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -O2 -g
INCLUDES = -I../include -I../lib/nlohmann_json/single_include
LIBS = -lpthread

# Source files
OPTIMIZER_SOURCES = ../src/core/consensus_performance_optimizer.cpp \
                   ../src/core/logger.cpp \
                   ../src/core/consensus_harmony.cpp

TEST_SOURCES = consensus_performance_optimizer_test.cpp

# Object files
OPTIMIZER_OBJECTS = $(OPTIMIZER_SOURCES:.cpp=.o)
TEST_OBJECTS = $(TEST_SOURCES:.cpp=.o)

# Target executable
TARGET = test_consensus_performance_optimizer

# Default target
all: $(TARGET)

# Build the test executable
$(TARGET): $(OPTIMIZER_OBJECTS) $(TEST_OBJECTS)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LIBS)

# Compile source files
%.o: %.cpp
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Run tests
test: $(TARGET)
	./$(TARGET)

# Run tests with verbose output
test-verbose: $(TARGET)
	./$(TARGET) --verbose

# Run performance benchmark
benchmark: $(TARGET)
	./$(TARGET) --benchmark

# Clean build artifacts
clean:
	rm -f $(OPTIMIZER_OBJECTS) $(TEST_OBJECTS) $(TARGET)

# Clean all including backup files
clean-all: clean
	rm -f *~ ../*~ ../src/core/*~ ../include/core/*~

# Install dependencies (if needed)
install-deps:
	@echo "Installing dependencies..."
	@echo "Make sure nlohmann/json is available in ../lib/nlohmann_json/"

# Debug build
debug: CXXFLAGS += -DDEBUG -g3
debug: $(TARGET)

# Release build
release: CXXFLAGS += -DNDEBUG -O3
release: clean $(TARGET)

# Memory check with valgrind
memcheck: $(TARGET)
	valgrind --leak-check=full --show-leak-kinds=all ./$(TARGET)

# Static analysis with cppcheck
static-analysis:
	cppcheck --enable=all --std=c++17 $(OPTIMIZER_SOURCES) $(TEST_SOURCES)

# Format code
format:
	clang-format -i $(OPTIMIZER_SOURCES) $(TEST_SOURCES)

# Show help
help:
	@echo "Available targets:"
	@echo "  all          - Build the test executable (default)"
	@echo "  test         - Build and run tests"
	@echo "  test-verbose - Build and run tests with verbose output"
	@echo "  benchmark    - Build and run performance benchmarks"
	@echo "  clean        - Remove build artifacts"
	@echo "  clean-all    - Remove all generated files"
	@echo "  debug        - Build with debug flags"
	@echo "  release      - Build optimized release version"
	@echo "  memcheck     - Run with valgrind memory checking"
	@echo "  static-analysis - Run static code analysis"
	@echo "  format       - Format source code"
	@echo "  help         - Show this help message"

.PHONY: all test test-verbose benchmark clean clean-all install-deps debug release memcheck static-analysis format help