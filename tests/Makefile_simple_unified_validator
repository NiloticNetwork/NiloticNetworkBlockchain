# Simple Makefile for Unified Transaction Validator Test

CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -O2 -g
INCLUDES = -I../include -I../lib/nlohmann_json/single_include
LIBS = -lpthread

# Source files (minimal set)
SOURCES = ../src/core/unified_transaction_validator.cpp \
          ../src/core/consensus_harmony.cpp \
          ../src/core/logger.cpp \
          ../src/core/utils.cpp \
          simple_unified_validator_test.cpp

# Target executable
TARGET = test_simple_unified_validator

# Default target
all: $(TARGET)

# Build the test executable
$(TARGET): $(SOURCES)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -o $@ $^ $(LIBS)

# Run tests
test: $(TARGET)
	./$(TARGET)

# Clean build artifacts
clean:
	rm -f $(TARGET)

.PHONY: all test clean